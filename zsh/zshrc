# Interactive non-login terminals need the same environment as login terminals.
if [ -z "${RAIP_PROFILE_LOADED:-}" ] && ! [[ -o login ]]; then
  [ -f "$HOME/.zprofile" ] && source "$HOME/.zprofile"
fi

# eza - a modern replacement for ls
alias ls='eza --icons --group-directories-first'
alias ll='eza -lh --icons'          # detailed list
alias la='eza -a --icons'           # with hidden files
alias lt='eza --tree --icons'       # tree output

# common aliases
alias c='clear'
alias ..='cd ..'

alias pip='python3 -m pip'

[ -f "$HOMEBREW_PREFIX/etc/profile.d/z.sh" ] && source "$HOMEBREW_PREFIX/etc/profile.d/z.sh"
[ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# aliases (path resolved through the ~/.zshrc symlink)
source "${${(%):-%x}:A:h}/aliases.zsh"

# work config (not in public repo)
[ -f "$HOME/.zshrc.work" ] && source "$HOME/.zshrc.work"
